      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "capacityTonsPerDay": { "type": "number" },
        "lastServicedDate": { "type": "string" },
        "nextServiceDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Operational", "Needs Service", "Breakdown"] },
        "breakdownNote": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "model", "capacityTonsPerDay", "lastServicedDate", "nextServiceDate", "status", "memberUids", "createdAt", "updatedAt"]
    },
    "SupplierItem": {
      "title": "SupplierItem",
      "description": "Supplier accounts, purchases, and dues",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "itemSupplied": { "type": "string" },
        "totalPurchases": { "type": "number" },
        "dues": { "type": "number" },
        "lastPaymentDate": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "phone", "itemSupplied", "totalPurchases", "dues", "memberUids", "createdAt", "updatedAt"]
    },
    "SafetyIncident": {
      "title": "SafetyIncident",
      "description": "Safety incident report and follow-up",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved"] },
        "followUp": { "type": "string" },
        "reportedBy": { "type": "string" },
        "date": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "description", "severity", "status", "reportedBy", "date", "memberUids", "createdAt", "updatedAt"]
    },
    "FactorySettings": {
      "title": "FactorySettings",
      "description": "Company profile, rates, and operations start date",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "iceBlockRate": { "type": "number" },
        "iceCubeRate": { "type": "number" },
        "operationsStartDate": { "type": "string" },
        "notificationsEnabled": { "type": "boolean" },
        "seededDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "companyName", "phone", "address", "iceBlockRate", "iceCubeRate", "operationsStartDate", "notificationsEnabled", "seededDemo", "createdAt", "updatedAt"]
    },
    "FactoryDirectoryEntry": {
      "title": "FactoryDirectoryEntry",
      "description": "Primary factory owner lookup entry for linking staff and admins",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "companyName": { "type": "string" },
        "ownerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "companyName", "ownerName", "createdAt", "updatedAt"]
    },
    "AppReleaseConfig": {
      "title": "AppReleaseConfig",
      "description": "Live app release metadata for cross-user update notifications and APK download",
      "type": "object",
      "properties": {
        "latestVersionCode": { "type": "integer" },
        "latestVersionName": { "type": "string" },
        "releaseNotes": { "type": "string" },
        "releaseNotesUrdu": { "type": "string" },
        "apkDownloadUrl": { "type": "string" },
        "mandatory": { "type": "boolean" },
        "publishedBy": { "type": "string" },
        "publishedAtIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["latestVersionCode", "latestVersionName", "createdAt", "updatedAt"]
    },
    "RegistrationRequest": {
      "title": "RegistrationRequest",
      "description": "Staff/Manager/Admin/Super Admin registration approval request",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "applicantUid": { "type": "string" },
        "name": { "type": "string" },
        "fatherName": { "type": "string" },
        "cnic": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "email": { "type": "string" },
        "emergencyContact": { "type": "string" },
