        "date": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "vehicleNumber", "driverName", "route", "customerName", "tons", "status", "date", "memberUids", "createdAt", "updatedAt"]
    },
    "MachineItem": {
      "title": "MachineItem",
      "description": "Factory ice machine and maintenance schedule",
