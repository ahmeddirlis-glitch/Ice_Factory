      },
      "required": ["ownerId", "applicantUid", "name", "cnic", "phone", "shift", "joinDate", "emergencyContact", "status", "createdAt", "updatedAt"]
    },
    "FactoryNotice": {
      "title": "FactoryNotice",
      "description": "Holiday and operational broadcast notice",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "titleUrdu": { "type": "string" },
        "message": { "type": "string" },
        "messageUrdu": { "type": "string" },
        "noticeType": { "type": "string", "enum": ["Holiday", "Urgent", "Salary", "General"] },
        "date": { "type": "string" },
        "active": { "type": "boolean" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "message", "noticeType", "date", "active", "createdByName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/factory_directory/{directoryId}": {
      "schema": { "$ref": "#/entities/FactoryDirectoryEntry" },
      "description": "Primary factory owner directory entry"
    },
    "/app_releases/{releaseId}": {
      "schema": { "$ref": "#/entities/AppReleaseConfig" },
      "description": "Latest app update release metadata for all users"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user settings and profile"
    },
    "/factories/{factoryId}/registration_requests/{requestId}": {
      "schema": { "$ref": "#/entities/RegistrationRequest" },
      "description": "Staff and admin registration requests awaiting Super Admin approval"
    },
    "/factories/{factoryId}/profile_update_requests/{requestId}": {
      "schema": { "$ref": "#/entities/ProfileUpdateRequest" },
      "description": "Non-admin user profile update requests awaiting Admin / Super Admin approval"
    },
    "/factories/{factoryId}/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/FactoryNotice" },
      "description": "Factory holiday and operational notices"
    },
    "/factories/{factoryId}/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Owner-only staff roster and encrypted face templates"
    },
    "/factories/{factoryId}/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Staff attendance check-in/out records"
    },
    "/factories/{factoryId}/production/{productionId}": {
      "schema": { "$ref": "#/entities/ProductionRecord" },
      "description": "Ice production logs in tons"
    },
    "/factories/{factoryId}/inventory/{inventoryId}": {
      "schema": { "$ref": "#/entities/InventoryMovement" },
      "description": "Cold room stock and inventory movements"
    },
    "/factories/{factoryId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer credit ledger"
    },
    "/factories/{factoryId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Sales and invoicing entries"
    },
    "/factories/{factoryId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Daily expenses and factory build capital entries"
    },
    "/factories/{factoryId}/funding/{fundingId}": {
      "schema": { "$ref": "#/entities/FundingEntry" },
      "description": "Owner-only funding and loan ledger"
    },
    "/factories/{factoryId}/payroll/{payrollId}": {
      "schema": { "$ref": "#/entities/PayrollRecord" },
      "description": "Owner-only salary and payroll records"
    },
    "/factories/{factoryId}/utilities/{utilityId}": {
      "schema": { "$ref": "#/entities/UtilityReading" },
      "description": "Electricity, diesel, and water readings and bills"
    },
    "/factories/{factoryId}/deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/DeliveryItem" },
      "description": "Vehicle dispatch and delivery tracking"
    },
    "/factories/{factoryId}/machines/{machineId}": {
      "schema": { "$ref": "#/entities/MachineItem" },
      "description": "Ice machines and service schedules"
    },
    "/factories/{factoryId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/SupplierItem" },
      "description": "Suppliers, purchases, and dues"
    },
    "/factories/{factoryId}/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/SafetyIncident" },
      "description": "Safety incident reports"
    },
    "/factories/{factoryId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/FactorySettings" },
      "description": "Owner-only factory configuration"
    }
  }
}
