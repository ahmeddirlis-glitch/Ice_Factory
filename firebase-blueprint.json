{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user preferences and personal contact info",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User full name" },
        "email": { "type": "string", "description": "User email" },
        "phone": { "type": "string", "description": "User phone number" },
        "photoUrl": { "type": "string", "description": "Profile photo URL" },
        "preferredLanguage": { "type": "string", "enum": ["en", "ur"] },
        "darkMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "preferredLanguage", "darkMode", "createdAt", "updatedAt"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Factory employee directory, role, salary, and encrypted face template (Owner only)",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "authUid": { "type": "string" },
        "name": { "type": "string" },
        "fatherName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "email": { "type": "string" },
        "cnic": { "type": "string" },
        "role": { "type": "string", "enum": ["Super Admin", "Owner", "Admin", "Manager", "Staff"] },
        "salary": { "type": "number" },
        "shift": { "type": "string" },
        "joinDate": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "skipLiveness": { "type": "boolean" },
        "faceTemplateEncrypted": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "phone", "cnic", "role", "salary", "shift", "joinDate", "emergencyContact", "skipLiveness", "active", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily face-verified check-in and check-out record",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "authUid": { "type": "string" },
        "date": { "type": "string" },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "status": { "type": "string", "enum": ["Present", "Absent", "Leave", "Checked Out"] },
        "bypassed": { "type": "boolean" },
        "hours": { "type": "number" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "employeeId", "employeeName", "authUid", "date", "checkIn", "checkOut", "status", "bypassed", "hours", "memberUids", "createdAt", "updatedAt"]
    },
    "ProductionRecord": {
      "title": "ProductionRecord",
      "description": "Daily ice production entry in tons",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "date": { "type": "string" },
        "tons": { "type": "number" },
        "productType": { "type": "string" },
        "machineId": { "type": "string" },
        "machineName": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "tons", "productType", "machineId", "machineName", "createdBy", "memberUids", "createdAt", "updatedAt"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Cold room stock overview and stock in/out movement",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "product": { "type": "string" },
        "tons": { "type": "number" },
        "location": { "type": "string" },
        "movementType": { "type": "string", "enum": ["IN", "OUT", "ADJUST"] },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "product", "tons", "location", "movementType", "createdBy", "memberUids", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Ice factory customer ledger and outstanding credit balance",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "balance": { "type": "number" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "phone", "balance", "memberUids", "createdAt", "updatedAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Ice sales and invoice entry (paid or credit)",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "product": { "type": "string" },
        "quantity": { "type": "integer" },
        "unitPrice": { "type": "number" },
        "total": { "type": "number" },
        "paid": { "type": "boolean" },
        "paidAmount": { "type": "number" },
        "date": { "type": "string" },
        "createdBy": { "type": "string" },
        "source": { "type": "string", "enum": ["manual", "voice"] },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "invoiceNumber", "customerId", "customerName", "product", "quantity", "unitPrice", "total", "paid", "paidAmount", "date", "createdBy", "source", "memberUids", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense or factory build capital investment entry",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string", "enum": ["Electricity", "Rent", "Diesel", "Water", "Salary", "Refreshment", "Maintenance", "Supplier", "Other", "Factory Build"] },
        "capitalInvestment": { "type": "boolean" },
        "date": { "type": "string" },
        "createdBy": { "type": "string" },
        "source": { "type": "string", "enum": ["manual", "voice"] },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "description", "amount", "category", "capitalInvestment", "date", "createdBy", "source", "memberUids", "createdAt", "updatedAt"]
    },
    "FundingEntry": {
      "title": "FundingEntry",
      "description": "Owner-only loans and investor capital funding ledger",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "source": { "type": "string", "enum": ["Friend", "Bank", "Investor", "Customer"] },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Loan", "Investment"] },
        "amount": { "type": "number" },
        "repaid": { "type": "number" },
        "interest": { "type": "number" },
        "dueDate": { "type": "string" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "source", "name", "type", "amount", "repaid", "interest", "date", "createdAt", "updatedAt"]
    },
    "PayrollRecord": {
      "title": "PayrollRecord",
      "description": "Owner-only monthly salary and payroll slips",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "employeeId": { "type": "string" },
        "authUid": { "type": "string" },
        "employeeName": { "type": "string" },
        "month": { "type": "string" },
        "baseSalary": { "type": "number" },
        "advances": { "type": "number" },
        "deductions": { "type": "number" },
        "netPay": { "type": "number" },
        "paid": { "type": "boolean" },
        "paidDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "employeeId", "employeeName", "month", "baseSalary", "advances", "deductions", "netPay", "paid", "createdAt", "updatedAt"]
    },
    "UtilityReading": {
      "title": "UtilityReading",
      "description": "Electricity, diesel, and water meter readings and bills",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "type": { "type": "string", "enum": ["Electricity", "Diesel", "Water"] },
